# ---------------------------------------------------------------------------
# Claude Chokidar - configuration
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# These cookies are as powerful as your password: never commit or share them.
# ---------------------------------------------------------------------------

# REQUIRED. The value of your claude.ai `sessionKey` cookie.
#
# Where to find it:
#   1. Open https://claude.ai in the Chrome you are normally signed in to.
#   2. Press F12 -> "Application" tab -> Storage -> Cookies -> https://claude.ai
#   3. Click the row named exactly `sessionKey` and copy its Value.
#   4. Paste it below. It looks like: sk-ant-sid02-xxxxxxxx...(~130 characters)
#
# Do not paste the cookie NAME, quotes, or a trailing semicolon - value only.
SESSION_KEY=sk-ant-sid02-REPLACE_ME

# OPTIONAL. claude.ai also sets V3 / LC variants of the session cookie. The bot
# works with SESSION_KEY alone; add these only if sign-in ever fails without
# them. Copy each one's Value from the same cookie list.
#
# Cookie name      -> key to use here
#   sessionKeyV3   -> SESSION_KEYV3
#   sessionKeyLC   -> SESSION_KEYLC
#   sessionKeyV3LC -> SESSION_KEYV3LC
#
# If the cookie list shows the SAME name twice (claude.ai stores one host-only
# and one domain-wide copy), put the second value in a `_v2` key, e.g.
# SESSION_KEYV3_v2.
#SESSION_KEYV3=
#SESSION_KEYV3_v2=
#SESSION_KEYLC=
#SESSION_KEYV3LC=
