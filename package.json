{
  "name": "claude-logout",
  "version": "1.0.0",
  "description": "Playwright bot that watches your Claude account's active sessions and terminates any session that is not from a protected location (Mumbai, Navi Mumbai, Panvel, Bergen)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "bot": "node index.js",
    "bot:1m": "node index.js --interval 60",
    "bot:5m": "node index.js --interval 300",
    "bot:10m": "node index.js --interval 600",
    "bot:15m": "node index.js --interval 900",
    "bot:30s": "node index.js --interval 30",
    "bot:dry-run": "node index.js --dry-run",
    "once": "node index.js --once",
    "dry-run": "node index.js --dry-run --once",
    "session-key": "node save-session-key.js",
    "profiles": "node index.js --list-profiles",
    "chrome:debug": "node launch-chrome-debug.js",
    "connect": "node index.js --cdp 9222",
    "test": "node -e \"require('./index.js'); console.log('Syntax OK')\""
  },
  "keywords": [
    "claude",
    "playwright",
    "session-manager",
    "security-bot",
    "active-sessions"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
